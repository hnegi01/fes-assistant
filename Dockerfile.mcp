# MCP Streamable HTTP server container (mcp_server.server:app)

# 1) Base image
FROM python:3.11-slim

# 2) Basic Python runtime settings
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# 3) Workdir inside container
WORKDIR /app

# 4) OS-level deps (compiler tools for wheels + curl for debugging/health checks)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
 && rm -rf /var/lib/apt/lists/*

# 5) Install uv (pinned) and the locked Python dependencies.
#    pyproject.toml + uv.lock are the source of truth — the build is exactly
#    reproducible (`--frozen` refuses to run if the lock is out of date).
COPY --from=ghcr.io/astral-sh/uv:0.11 /uv /uvx /bin/
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev
# Put the project venv first on PATH so uvicorn/streamlit resolve from it.
ENV PATH="/app/.venv/bin:$PATH"

# 6) Copy only what the MCP server needs
COPY mcp_server ./mcp_server
COPY config ./config

# 7) Expose MCP HTTP port
# Note: EXPOSE is metadata only. The MCP server is NOT publicly accessible unless you publish it via docker-compose ports.
EXPOSE 8002

# 8) Run as non-root user (basic hardening)
RUN useradd -m appuser && chown -R appuser:appuser /app
USER appuser

# 9) Run the MCP Streamable HTTP server (Starlette)
CMD ["uvicorn", "mcp_server.server:app", "--host", "0.0.0.0", "--port", "8002"]