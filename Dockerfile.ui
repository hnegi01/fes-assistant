# Streamlit UI container (frontend/app.py)

# 1) Base image
FROM python:3.11-slim

# 2) Basic Python runtime settings
#
# NO STREAMLIT_* VARIABLES HERE, deliberately. Streamlit's precedence is
# CLI flag > environment variable > config.toml, so anything set here SILENTLY
# OVERRIDES .streamlit/config.toml — and this image used to set
# STREAMLIT_CLIENT_TOOLBAR_MODE=viewer alongside a config that said "minimal".
# The config lost, production kept its hamburger menu, and the old comment here
# described the pair as equivalent. They are not.
#
# server.port and server.address are passed as CLI flags in the CMD below;
# toolbar mode and usage stats live in .streamlit/config.toml, which ships in
# the image (see the COPY further down). One source per setting.
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# 3) Workdir inside container
WORKDIR /app

# 4) OS-level deps (only keep build-essential if any dependency needs compilation)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
 && rm -rf /var/lib/apt/lists/*

# 5) Install uv (pinned) and the locked Python dependencies.
#    pyproject.toml + uv.lock are the source of truth — the build is exactly
#    reproducible (`--frozen` refuses to run if the lock is out of date).
COPY --from=ghcr.io/astral-sh/uv:0.11 /uv /uvx /bin/
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev
# Put the project venv first on PATH so uvicorn/streamlit resolve from it.
ENV PATH="/app/.venv/bin:$PATH"

# 6) Copy only what the UI needs
COPY frontend ./frontend
# Streamlit reads .streamlit/config.toml relative to the working directory, so
# without this the deployed app silently runs on Streamlit's DEFAULTS while
# every local check passes against the real config. That is exactly what
# happened: production kept the hamburger menu (Print / Record / version) and
# ignored the pinned light theme, because toolbarMode and [theme] never left
# the developer's machine. Found 2026-09-01, after the config had been in the
# repo for weeks.
#
# Contains no secrets — only config.toml, which is tracked. Streamlit reads
# secrets from .streamlit/secrets.toml, so if one is ever added it must be
# supplied at runtime (env or a mount) and excluded here, never baked in.
COPY .streamlit ./.streamlit

# 7) Expose Streamlit port
# Note: EXPOSE is metadata only. The UI is publicly accessible only if you publish it via docker-compose ports,
# or route traffic to it via nginx.
EXPOSE 8501

# 8) Run as non-root user (basic hardening)
RUN useradd -m appuser && chown -R appuser:appuser /app
USER appuser

# 9) Run Streamlit UI
CMD ["streamlit", "run", "frontend/app.py", "--server.port=8501", "--server.address=0.0.0.0"]