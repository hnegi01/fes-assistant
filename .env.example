############################
# FES Assistant (.env.example)
#
# HOW TO USE: copy this file to `.env`, fill in your values, and start the
# stack. Lines starting with `#` are comments or optional settings — remove
# the leading `#` to activate one. This file is safe to commit; never put
# real secrets in it (your `.env` is gitignored and stays on your machine).
############################


############################
# 1. LLM PROVIDER — which AI model the agent thinks with
############################

# Pick ONE provider and fill in its block below.
# Values: "azure" | "databricks" | "huggingface"
LLM_PROVIDER=azure

# --- Azure OpenAI (fill these when LLM_PROVIDER=azure) ---
# Your Azure OpenAI resource URL, from the Azure portal.
# Looks like: https://<your-resource-name>.openai.azure.com
AZURE_OPENAI_ENDPOINT=
# The model deployment NAME you created inside that resource (not the model
# family name — whatever you typed in "Deployment name", e.g. gpt-4o).
AZURE_OPENAI_DEPLOYMENT=gpt-4o
# The API key from the Azure portal ("Keys and Endpoint" page).
# Leave empty if you fetch it from AWS Secrets Manager instead (see below).
AZURE_OPENAI_API_KEY=
# How the URL is built when calling Azure. "v1" is the modern style; only set
# "legacy" if your resource is old and v1 calls fail with 404s.
AZURE_OPENAI_API_STYLE=v1
# Azure API version. The backend reads it when AZURE_OPENAI_API_STYLE=legacy
# (the deployment-URL style needs an explicit api-version); scripts/02 also
# uses it when regenerating tool examples offline.
# AZURE_OPENAI_API_VERSION=2024-11-20
# --- Optional, ONLY for regenerating tool examples offline (scripts/02) ---
# Not needed to run the app. The Batch API needs a deployment with a
# globalbatch/datazonebatch SKU; without one the script just runs sequentially.
# AZURE_OPENAI_BATCH_DEPLOYMENT=gpt-4o-batch
# GENERATE_TOOL_EXAMPLES_LOG_LEVEL=INFO

# --- Databricks Model Serving (fill these when LLM_PROVIDER=databricks) ---
# DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
# DATABRICKS_TOKEN=            # a personal access token from your workspace
# LLM_ENDPOINT=your-serving-endpoint-name

# --- HuggingFace Inference API (fill these when LLM_PROVIDER=huggingface) ---
# HUGGINGFACE_API_KEY=hf-xxxxxxxxxxxxxxxxxxxxxxxx
# HUGGINGFACE_MODEL=mistralai/Mistral-7B-Instruct-v0.3
# Note: not every HF model supports tool/function calling — the agent needs it.

# --- Optional: keep the Azure key OUT of this file ---
# If set, the backend fetches the Azure OpenAI key from AWS Secrets Manager at
# startup instead of reading AZURE_OPENAI_API_KEY above (recommended on EC2).
AWS_REGION=us-east-2
FES_AZURE_OPENAI_SECRET_ID=fes_assistant_azure_openai


############################
# 2. OBSERVABILITY — tracing and usage records
############################

# LangSmith is an external cloud service that shows you a timeline of every
# agent turn (which LLM calls ran, which tools ran, cost per turn).
# true = send traces there; false = send nothing. Needs the API key below.
LANGSMITH_TRACING=false
# Your LangSmith API key (from smith.langchain.com → Settings → API Keys).
# LANGSMITH_API_KEY=lsv2_pt_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Which LangSmith project the traces are filed under (any name you like).
# LANGSMITH_PROJECT=fes_agent

# PRIVACY: may your Sisense DATA appear inside those LangSmith traces?
# false (recommended) = traces show the shape of every call (prompts, timings,
#   token counts) but every data-carrying part is replaced by a length-only
#   placeholder — no user lists, no dashboard names leave your machine.
# true = traces include the actual content; useful when debugging prompts.
# Tool result payloads NEVER go to LangSmith under either setting.
FES_LANGSMITH_LOG_CONTENT=false

# Local CSV records under logs/ (llm_traces.csv = one row per turn,
# llm_calls.csv = one row per LLM call, tool_calls.csv = one row per tool run).
# Purely local, no cloud. true = write them; false = don't.
# On by default: these rows are what cross-model accuracy comparison and the
# UI's thumbs-feedback join against (feedback.csv links to them by trace_id).
# They carry your request text and call metadata, never Sisense result data.
# Note: logs/mutations.log (the audit trail of every write) is ALWAYS on —
# that is an audit requirement, not observability, and has no off switch.
FES_CSV_OBSERVABILITY=true


############################
# 3. SCRIPT-ONLY PATHS (NOT needed to run the app)
############################

# Used only by scripts/02_add_llm_examples_to_registry.py when regenerating
# the tool registry after a PySisense SDK update. Defaults assume the pysisense
# repo is checked out NEXT TO this one; set these only if yours lives elsewhere.
# PYSISENSE_EXAMPLES_ROOT=/absolute/path/to/pysisense/examples
# PYSISENSE_DOCS_ROOT=/absolute/path/to/pysisense/docs


############################
# 4. HOW THE THREE SERVICES FIND EACH OTHER
############################

# Where the MCP tool server (mcp_server/server.py, port 8002) is, as seen from
# the backend. Change only if you moved it to another host/port.
PYSISENSE_MCP_HTTP_URL=http://localhost:8002

# How long (seconds) the backend waits for one tool call to finish before
# giving up. Migrations can genuinely run for many minutes — keep this high
# (1800 = 30 minutes) or long migrations get cut off mid-run.
PYSISENSE_MCP_HTTP_TIMEOUT=1800

# Tool calls are never retried — a timeout must not re-run a migration.

# Where the backend API (backend/api_server.py, port 8001) is, as seen from
# the Streamlit UI.
FES_BACKEND_URL=http://localhost:8001


############################
# 5. THE AGENT — how it plans, executes, and double-checks
############################

# Retries for LLM calls (these ARE safe to retry — asking twice is harmless).
LLM_HTTP_MAX_RETRIES=3
LLM_HTTP_RETRY_BASE_DELAY=0.5

# LLM call tuning. Defaults shown; uncomment only to override.
# LLM_HTTP_TIMEOUT=60     # seconds to wait for one LLM response
# LLM_MAX_TOKENS=1024     # longest answer the model may write per call
# LLM_TEMPERATURE=0.2     # 0 = most predictable; higher = more creative

# How many previous conversation turns the planner gets to see. This is what
# lets follow-ups like "now show its members" or "that datamodel" work.
# 0 = the planner sees only the latest message (every request must be
# self-contained). Higher = more context, slightly bigger prompts.
LLM_PLANNING_HISTORY_TURNS=5

# When the agent is missing a required value (e.g. an email address), it asks
# you. This is how many times it asks before giving up and telling you what it
# still needs. 2 is a good balance.
FES_CLARIFY_MAX_ATTEMPTS=2

# Hard ceiling on how many tool calls one request may make. A request like
# "list datamodels and all groups" uses one call per part. If the ceiling is
# hit, the agent returns what it finished plus what remains — never a silent
# stop. Raise for deeper multi-step work; lower to bound cost.
FES_MAX_AGENT_STEPS=8

# The "did I actually finish?" check. true = before delivering a final answer,
# one extra LLM call re-reads your original request against the results and
# catches skipped work ("you asked for X and Y, it only did X"). Costs one
# extra LLM call per request. Only active when summarization is ON (the check
# needs to read the results to judge them).
FES_VERIFY_GOAL=true
# How many times that check may send the agent back for one more step.
FES_VERIFY_MAX_RECHECKS=1

# When a step's result shows the current approach can't work (tool failed,
# found nothing, wrong kind of data), the planner may rewrite the rest of the
# plan and try a different approach. This is how many rewrites are allowed per
# request. 0 = never replan (fail fast).
FES_MAX_REPLANS=1

# Which engine runs the agent loop. Both produce identical behavior — the UI
# cannot tell them apart. You almost never need to change this.
#   langgraph -> LangGraph StateGraph (the default).
#                In-memory only: no checkpointer, no database, no files.
#   custom    -> the original hand-rolled loop, kept as a dependency-free
#                fallback in case a langgraph upgrade ever breaks something.
FES_AGENT_ENGINE=langgraph

# How many INDEPENDENT steps of a plan may run at the same time (e.g. "list
# users AND list groups" = two unrelated reads that can run in parallel).
# Steps that depend on each other, need clarification, or modify anything
# always run one at a time regardless. 1 = disable parallelism entirely.
FES_MAX_PARALLEL_STEPS=3

# Migration planning style. true (recommended) = the whole migration is
# planned in ONE LLM call, ordered by dependency by the planner (e.g. groups
# before the users assigned to them), shown to you as ONE numbered approval
# dialog so you can verify the order, then executed in sequence. false = old
# behavior: migrations go through the step-by-step chat loop (kept only as an
# emergency fallback).
FES_MIGRATION_SINGLE_SHOT=true

# Optional extra safety for UNATTENDED use: one more LLM call that checks a
# migration plan for forgotten asset kinds ("you asked for users AND groups,
# the plan only has users"). Off by default because the approval dialog lists
# every step — when a human reads that list, the human IS the check.
FES_MIGRATION_COMPLETENESS_CHECK=false

# Few-shot examples on the tool-selection call: how many of each tool's stored
# `user request -> arguments` examples the model sees when picking a tool and
# filling its arguments. Examples teach it to take values FROM your words
# instead of inventing them.
#   1 = the hand-vetted example (default, recommended) | 0 = none (turns the
#   feature off) | 2-3 = also the unvetted ones (not recommended until they
#   are cleaned up)
# Cost: ~35 extra prompt tokens per tool per selection call.
# Note: the first example is ALSO shown to users in approval dialogs and
# clarification questions — that happens regardless of this flag, which only
# controls what the MODEL sees.
FES_TOOL_EXAMPLES=1


############################
# 6. FRONTEND (STREAMLIT UI)
############################

# Hours of inactivity before a browser session's state is cleared.
FES_UI_IDLE_TIMEOUT_HOURS=9


############################
# 7. LOGGING
############################

# Log detail level for all three services, written under logs/.
# Values: DEBUG (everything) | INFO (normal) | WARNING | ERROR | CRITICAL
# INFO ships here, and matches the code default. It records what ran — every
# tool call, ok/failed, timings, the mutation audit — WITHOUT writing Sisense
# result rows to disk. DEBUG additionally writes full (secret-scrubbed) tool
# payloads and prompts into logs/, where they sit for 7 days — fine on a
# machine you control, worth a thought if that disk holds live BI data.
#
# DEBUG is the right choice on a machine you control, and worth knowing about
# in advance: the level is read at startup, so you cannot turn it up AFTER
# something odd happened — the evidence is already gone, and restarting to
# enable it destroys the state you wanted to inspect. All logs rotate daily
# (7 days kept), so DEBUG costs a few MB per day.
FES_LOG_LEVEL=INFO

# Extra-verbose logging from the PySisense SDK itself:
# Leave UNSET (recommended) = follows FES_LOG_LEVEL (on only at DEBUG).
# PYSISENSE_SDK_DEBUG=true    # force on, regardless of log level
# PYSISENSE_SDK_DEBUG=false   # force off, regardless of log level


############################
# 8. PRIVACY — may the AI read your Sisense data?
############################

# The agent runs tools that return real Sisense data (user lists, dashboards).
# "Summarization" means letting the LLM read those results to write better
# answers and chain steps together ("get the user, THEN look up their group"
# needs the model to read step 1's result).
#
# false = hard OFF. Data never reaches the LLM; you still see full results in
#         the UI, but answers are generic ("Found 80 results") and multi-step
#         requests that need to read intermediate data stop politely.
# true  = allowed, and each user can still turn it on/off per session with the
#         UI checkbox (see next flag). The checkbox always starts OFF either way.
#
# SHIPPED OFF ON PURPOSE, because the safe default for a tool pointed at a
# live BI environment is that its data stays there. Both flags below are
# false, enforced twice in code (the backend cap ANDs with the per-request
# flag, and a hidden checkbox always sends "off"), so no request — not even a
# hand-written API call asking for it — can send result data to the LLM.
# Turn them on when you are comfortable with your LLM provider seeing the
# results, e.g. a sandbox deployment or a provider inside your own tenancy.
ALLOW_SUMMARIZATION=false

# Whether that per-session checkbox is shown in the UI at all.
# false = hidden, AND summarization is forced OFF for every request (a hidden
#         checkbox always sends "off" — it does not freeze the value above).
#
# Both false = maximum-privacy posture, and what this file ships. The cost is
# real and worth knowing: no prose answers over result data, no adaptive
# multi-step chains ("get the user, THEN look up their group" stops after step
# one and says why), and no critic. Everything else still works — independent
# multi-step turns, migrations, approvals, clarifications, and the full result
# tables in the UI.
FES_ALLOW_SUMMARIZATION_TOGGLE=false


############################
# 9. TOOL SURFACE — which of the 119 generated tools are exposed
############################

# Path to the hand-edited allowlist. The tool registry is machine-generated
# from the PySisense SDK, so an SDK update can add methods nobody reviewed;
# ONLY tool ids listed in this file are usable — by the agent, the planner, or
# any MCP client. Comment a line out to retire a tool.
#
# If the file is MISSING entirely, all tools are allowed (with a warning) —
# deleting it disables the filter rather than hiding everything.
#
# The backend picks up edits on the next request; the MCP server reads it once
# at startup, so restart that process after editing.
# After a registry rebuild, check for drift with:
#   python scripts/04_generate_tool_allowlist.py
FES_TOOL_ALLOWLIST=config/allowed_tools.txt

# Path to the generated tool registry itself (default shown; rarely changed).
# PYSISENSE_REGISTRY_PATH=config/tools.registry.with_examples.json



############################
# 10. MCP SERVER CONCURRENCY (single-worker by design — never add workers)
############################

# Max long-running migrations at the same time, across ALL users.
PYSISENSE_MAX_CONCURRENT_MIGRATIONS=1
# Max quick/read tool calls at the same time.
PYSISENSE_MAX_CONCURRENT_READ_TOOLS=5

# Read-only mode. true (default) = tools that change things may run, each
# still gated by the approval dialog. false = every mutating tool is refused
# at the point of execution, so the deployment can only ever read — useful if
# you want to explore or demo with no chance of a write.
# PYSISENSE_ALLOW_MUTATIONS=true

# Your Sisense connection is NOT set here. You enter the domain and API token
# in the app's sidebar, and they are attached to each tool call at the moment
# it runs — so nothing is stored on the server and there is no environment
# variable to leak. If a call arrives without them it fails loudly rather than
# falling back to some default deployment.
