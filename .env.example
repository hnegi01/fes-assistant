############################
# FES Assistant (.env.example)
# This file is safe to commit. Do NOT put real secrets here.
############################


############################
# LLM PROVIDER CONFIG
############################

# Which provider to use for the FES agent: "azure", "databricks", or "huggingface"
LLM_PROVIDER=azure

# --- Azure OpenAI (if LLM_PROVIDER=azure) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_KEY=
# v1 = new /openai/v1/chat/completions style; "legacy" for older deployment-style URL
AZURE_OPENAI_API_STYLE=v1
# Optional (To use Batch LLM API Call for tool generation)
# AZURE_OPENAI_API_VERSION=2024-11-20
# Batch API requires a deployment with globalbatch or datazonebatch SKU (not GlobalStandard).
# Create a separate deployment in Azure Portal for this. Falls back to sequential if not set.
# AZURE_OPENAI_BATCH_DEPLOYMENT=gpt-4o-batch
# Log level for the example-generation script (scripts/02) only
# GENERATE_TOOL_EXAMPLES_LOG_LEVEL=INFO

# --- Databricks (if LLM_PROVIDER=databricks) ---
# DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
# DATABRICKS_TOKEN=
# LLM_ENDPOINT=your-serving-endpoint-name

# --- HuggingFace Inference API (if LLM_PROVIDER=huggingface) ---
# HUGGINGFACE_API_KEY=hf-xxxxxxxxxxxxxxxxxxxxxxxx
# HUGGINGFACE_MODEL=mistralai/Mistral-7B-Instruct-v0.3
# Note: not all HF models support function calling. Stick to instruction-tuned models.

# Optional: fetch Azure OpenAI secrets from AWS Secrets Manager (recommended for EC2)
AWS_REGION=us-east-1
FES_AZURE_OPENAI_SECRET_ID=fes_assistant_azure_openai

############################
# LangSmith Observability
############################

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LANGSMITH_PROJECT=fes_agent

# Whether result DATA may appear in LangSmith traces (an EXTERNAL cloud
# service — a separate trust boundary from your LLM provider, hence a dedicated
# flag independent of ALLOW_SUMMARIZATION). Prompts/messages are always shown
# (system prompts, your text, plan text carry no Sisense data); with this flag
# false, ONLY the data-bearing parts are redacted to length-only placeholders:
#   - tool results embedded in decide/verify prompts (dependent tasks)
#   - result-derived step texts (adaptive value-passing) and prior replies
#   - outputs of answer-producing calls (decide/finalize/verify/replan) + reply
# Tool runs always carry metadata only (tool_id, scrubbed args, ok, count,
# duration) — result payloads NEVER go to LangSmith regardless of this flag.
FES_LANGSMITH_LOG_CONTENT=false

# Local CSV observability (logs/llm_traces.csv, llm_calls.csv, tool_calls.csv).
# Off by default — same closed-by-default stance as LangSmith content; each
# observability destination has its own switch. Set true to keep local records
# (one row per turn / per LLM call / per tool execution, grouped by trace_id).
# The mutations audit log (logs/mutations.log) is NOT gated by this: audit is a
# requirement, not observability.
FES_CSV_OBSERVABILITY=false

############################
# PYSISENSE DOCS / EXAMPLES (script-only — NOT needed to run the app)
############################

# Used ONLY by scripts/02_add_llm_examples_to_registry.py (offline registry
# regeneration after an SDK update, via refresh_registry.sh). Defaults assume
# the pysisense repo is checked out next to fes-assistant (../pysisense/...);
# set these only if yours lives elsewhere.
# PYSISENSE_EXAMPLES_ROOT=/absolute/path/to/pysisense/examples
# PYSISENSE_DOCS_ROOT=/absolute/path/to/pysisense/docs


############################
# MCP HTTP SERVER CONFIG
############################

# Where the PySisense MCP HTTP server (mcp_server/server.py) is running
PYSISENSE_MCP_HTTP_URL=http://localhost:8002

# Timeout (seconds) for MCP HTTP calls.
# Keep this high if you run long migrations via MCP.
PYSISENSE_MCP_HTTP_TIMEOUT=1800

# IMPORTANT: keep retries low for non-idempotent operations (e.g., migrations)
MCP_HTTP_MAX_RETRIES=1
MCP_HTTP_RETRY_BASE_DELAY=0.5

# MCP protocol version sent on initialize (both client and server read it)
# MCP_PROTOCOL_VERSION=2025-11-25

# Optional: auto-subscribe to GET /mcp/ SSE stream on connect() (recommended)
# MCP_AUTO_SUBSCRIBE=true

# Optional: override which tool ids are treated as streaming-sensitive
# MCP_STREAMING_TOOL_IDS=migration.migrate_all_dashboards,migration.migrate_all_datamodels


############################
# BACKEND (FASTAPI)
############################

# Where the FES backend API (backend/api_server.py) is running
FES_BACKEND_URL=http://localhost:8001

# LLM HTTP retry config (safe to retry)
LLM_HTTP_MAX_RETRIES=3
LLM_HTTP_RETRY_BASE_DELAY=0.5

# LLM call tuning (defaults shown; uncomment to override)
# LLM_HTTP_TIMEOUT=60
# LLM_MAX_TOKENS=1024
# LLM_TEMPERATURE=0.2

# Number of prior conversation turns (user + assistant pairs) sent to the planner.
# Gives the LLM context for follow-up references ("that datamodel", "the Sales group").
# Set to 0 to disable history (planning sees only the latest user message).
LLM_PLANNING_HISTORY_TURNS=5

# Max times the agent will ask a follow-up clarification question before giving up.
# After this many attempts the agent tells the user what information it still needs
# and stops asking. Raise for more patient flows; lower for tighter UX.
FES_CLARIFY_MAX_ATTEMPTS=2

# Hard ceiling on tool-executing steps in a single agent turn. A multi-step
# request (e.g. "list datamodels and all groups") runs one SDK call per step;
# on reaching this cap the agent returns what it did plus what still remains,
# never a silent stop. Raise for deeper autonomous chains; lower to bound cost.
FES_MAX_AGENT_STEPS=8

# Independent goal check (verify #3). When true, before accepting a "done"
# answer a separate adversarial LLM call re-reads the whole request against the
# results to catch work the agent skipped ("declared victory too early"). Runs
# only when summarization is ON (judging goal achievement needs the result data;
# with summarization off it would see only metadata the agent already checked).
# Costs one extra LLM call per turn. Set false to skip it. Per-step verification
# (schema + ok flag) is deterministic code and is always on regardless.
FES_VERIFY_GOAL=true

# How many times that goal checker may override a "done" and push the loop to
# run one more step. Bounds the extra cost; FES_MAX_AGENT_STEPS still applies.
FES_VERIFY_MAX_RECHECKS=1

# Plan->replan: how many times per turn the strategist may REVISE the plan after
# a step's outcome shows the approach can't work (failed / found nothing / wrong
# kind of data). The replanner sees a compact catalog of all operations (name +
# one-line description, no schemas) so it can pick a genuinely different
# approach. 0 disables replanning. FES_MAX_AGENT_STEPS still applies on top.
FES_MAX_REPLANS=1

# Agent engine: which harness runs the turn. Both are thin control flow over
# the SAME helpers (planner, router, tool selection, gate, critic...) and honor
# the same contract — the UI/API cannot tell them apart.
#   custom    -> the hand-rolled reactive loop (default, battle-tested)
#   langgraph -> LangGraph StateGraph (nodes: planner/branch/join/select/
#                validator/gate/tools/decide) with Send-API fan-out. In-memory
#                only: no checkpointer, no database, no files.
FES_AGENT_ENGINE=langgraph

# Parallel fan-out: how many INDEPENDENT plan steps may execute concurrently
# (each with its own route->plan->execute pipeline; results join into the shared
# transcript in plan order). Mutations, missing-arg clarifications, and dead
# ends never run in a branch — they defer to the sequential loop. 1 disables
# fan-out. Downstream concurrency is bounded by the MCP server's
# PYSISENSE_MAX_CONCURRENT_READ_TOOLS semaphore (default 5).
FES_MAX_PARALLEL_STEPS=3

# Migration turns plan every step in ONE LLM call, sort them into dependency
# order in code (groups -> users -> datamodels -> dashboards), and execute in
# sequence with an approval gate on each. No migration tool consumes a value
# another produces, so the chat loop's per-step "what next?" calls buy nothing.
# false routes migration back through the reactive loop (kill switch).
FES_MIGRATION_SINGLE_SHOT=true

# Opt-in second pair of eyes on a migration plan: one extra LLM call that checks
# the plan for omitted asset kinds, with one re-plan if it names any. Off by
# default — every plan is shown as a numbered step list before anything runs, so
# the approving human is the completeness check. Enable for unattended/API use.
FES_MIGRATION_COMPLETENESS_CHECK=false

# Few-shot examples on the tool-SELECTION call: how many of each tool's curated
# `user_query -> arguments` examples (stored in the registry) get appended to
# that tool's description before the LLM picks a tool and fills its arguments.
#   0 -> no examples (default; byte-identical to the pre-flag prompt)
#   1 -> one example per tool   (recommended — example[0] is the vetted one)
#   2 -> two examples per tool
#   3 -> three examples per tool (all of them)
# Only example[0] has been curated so every argument value also appears in the
# request text — that is what teaches "take values FROM the user, never invent
# them", reinforcing the same rule PLANNING_SYSTEM_PROMPT states in prose. The
# ex1/ex2 siblings are not yet curated, so 2-3 may reintroduce examples that
# demonstrate inventing an email or an ObjectId. Prefer 1 until they are cleaned.
# Cost: roughly +35 tokens per tool per selection call (~+380 on an 11-tool
# mixin, about +40%). Examples never go to the planner — it writes prose steps
# and never emits arguments. A/B this against tests/integration/test_evals_planner.py
# rather than by feel; more examples is not automatically better.
FES_TOOL_EXAMPLES=0


############################
# FRONTEND (STREAMLIT UI)
############################

# Streamlit session idle timeout (hours) before we clear session_state
FES_UI_IDLE_TIMEOUT_HOURS=9


############################
# LOGGING
############################

# Global log level for UI + backend + MCP server
# Allowed: DEBUG, INFO, WARNING, ERROR, CRITICAL
FES_LOG_LEVEL=INFO

# Control pysisense SDK debug behaviour:
# Option A (recommended): tie SDK debug to FES_LOG_LEVEL
# (Leave PYSISENSE_SDK_DEBUG unset. Do not define it at all.)
#
# Option B: always enable verbose SDK debug
# PYSISENSE_SDK_DEBUG=true
#
# Option C: always disable SDK debug
# PYSISENSE_SDK_DEBUG=false


############################
# SUMMARIZATION / PRIVACY
############################

# Hard kill switch for sending tool results (Sisense data) to the LLM for summarization.
# false -> summarization completely disabled (UI cannot override)
# true  -> summarization allowed (subject to UI toggle)
ALLOW_SUMMARIZATION=false

# UI: whether the checkbox to allow summarization is visible/enabled
# true  -> user can toggle in the UI
# false -> checkbox is disabled (always off)
FES_ALLOW_SUMMARIZATION_TOGGLE=false


# ------------------------------------------------------------------------------
# Curated tool surface (read by BOTH the backend and the MCP server)
# ------------------------------------------------------------------------------
# Path to the hand-edited allowlist of tool_ids that may be exposed at all.
# The registry is machine-generated from the PySisense SDK, so a refresh can
# introduce methods that should never reach a user; only tool_ids listed in this
# file are loaded into the agent registry, offered to the tool-selection LLM, or
# dispatched by the MCP server. Comment out a line to retire a tool.
#
# If the file is MISSING, every registry tool is allowed and a warning is logged
# — deleting it disables the allowlist rather than hiding everything.
#
# The backend re-reads it on mtime change (edit takes effect next turn); the MCP
# server reads it once at import, so restart that process after an edit.
#
# Audit drift after a registry rebuild:
#   python scripts/04_generate_tool_allowlist.py
FES_TOOL_ALLOWLIST=config/allowed_tools.txt

# Path to the generated tool registry (read by both backend and MCP server)
# PYSISENSE_REGISTRY_PATH=config/tools.registry.with_examples.json

# MCP server: additionally restrict to these registry modules (comma-separated,
# e.g. "datamodel,dashboard"). Empty = all modules. Coarser than the allowlist.
# ALLOW_MODULES=


# ------------------------------------------------------------------------------
# MCP Server tool naming mode
# ------------------------------------------------------------------------------
# Claude Desktop rejects tool names that contain '.' during tools/list discovery.
# Set to "claude" to publish underscore tool names.
# The server will still ACCEPT both underscore and dotted names on tool calls.
MCP_TOOL_NAME_MODE=claude
# MCP_TOOL_NAME_MODE=canonical


# ------------------------------------------------------------------------------
# MCP Server concurrency caps (single-worker friendly)
# ------------------------------------------------------------------------------
# Limit how many long-running migrations can run at the same time.
PYSISENSE_MAX_CONCURRENT_MIGRATIONS=3

# Limit how many short/read tools can run concurrently while migrations are running.
PYSISENSE_MAX_CONCURRENT_READ_TOOLS=5


# NOTE: the env default-tenant fallback (PYSISENSE_USE_DEFAULT_TENANT /
# PYSISENSE_USE_DEFAULT_MIGRATION_TENANTS and PYSISENSE_DEFAULT_*) was REMOVED
# 2026-08-14. Credentials always come from the caller (the UI sidebar, injected
# per tool call by the backend); test credentials live in
# tests/integration/integration_config.yaml. Missing credentials are an error,
# never a silent fallback to an env-configured environment.